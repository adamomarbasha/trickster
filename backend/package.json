{
  "name": "magic-number-backend",
  "version": "1.0.0",
  "description": "Minimal Twilio SMS backend for Magic Number.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "twilio",
    "sms",
    "express",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
